# oompah environment configuration
#
# Copy this file to .env and fill in your values.
# The .env file is loaded automatically on startup, or you can specify a
# different path with: oompah --env-file /path/to/your.env
#
# Values in this file take precedence over inherited shell environment
# variables when oompah starts.

# ---------------------------------------------------------------------------
# Webhook forwarding
# ---------------------------------------------------------------------------

# URL passed to 'gh webhook forward --url' for each project's gh CLI invocation.
# Each project runs its own gh webhook forward process in its repo_path.
# Defaults to http://localhost:8080/api/v1/webhooks/github if not set.
OOMPAH_WEBHOOK_FORWARD_URL=http://localhost:8080/api/v1/webhooks/github

# Comma-separated list of GitHub event types to subscribe to via
# 'gh webhook forward --events'. Must include all events oompah parses:
#   push, pull_request         — SCM events (source sync, PR lifecycle)
#   issues, issue_comment      — task changes for GitHub-backed task tracking
#   label                      — label create/edit/delete for routing hints
# Do not include projects_v2_item here: GitHub rejects that event for
# repository-scoped hooks created by 'gh webhook forward'. Oompah can parse
# projects_v2_item if an organization/user-level webhook delivers it separately.
# Removing an event from this list silences that event type even when
# oompah has parsing code for it.
# OOMPAH_WEBHOOK_EVENTS=push,pull_request,issues,issue_comment,label

# Optional public HTTPS base URL override for GitLab Project Hooks. When set,
# Oompah creates and reconciles hooks at
# <this URL>/api/v1/webhooks/gitlab. When unset, each GitLab project's callback
# defaults to http://<route-selected-local-IP>:<OOMPAH_SERVER_PORT>/api/v1/webhooks/gitlab,
# using the same local IP the OS selects when routing to that GitLab server.
# Set the override for TLS, reverse proxies, NAT, public GitLab, or whenever
# GitLab cannot reach the automatically selected private address. Do not use
# localhost or include the webhook path here. This is the public Oompah URL,
# not the GitLab forge/API URL, and it is independent of
# OOMPAH_HTPASSWD_FILE.
# OOMPAH_GITLAB_WEBHOOK_PUBLIC_URL=https://oompah.example.com

# ---------------------------------------------------------------------------
# GitHub / GitLab authentication
# ---------------------------------------------------------------------------

# GitHub personal access token (used by the gh CLI for repository operations).
# When webhook forwarding is enabled, a fine-grained token MUST grant the
# target repository Webhooks: Read and write so `gh webhook forward` can
# create and manage its repository webhook. It also needs the permissions for
# the other oompah features you enable (for example, Contents and Pull
# requests). Alternatively, run `gh auth login` to authenticate interactively.
GITHUB_TOKEN=ghp_...

# GitHub Issues task hub used when WORKFLOW.md has tracker.kind=github_issues
# and a managed project does not provide its own tracker_owner/tracker_repo.
OOMPAH_GITHUB_TRACKER_OWNER=lesserevil
OOMPAH_GITHUB_TRACKER_REPO=oompah
# Optional GitHub Projects v2 board node ID for the task hub.
# OOMPAH_GITHUB_PROJECT_NODE_ID=

# Native Markdown tracker writes task files under .oompah/tasks and commits /
# pushes them from the managed source checkout by default. Disable only for
# tests or one-off local experiments.
# OOMPAH_MD_TRACKER_GIT_SYNC=1

# GitLab personal access token (used by the glab CLI for MR operations).
# Alternatively, run `glab auth login` to authenticate interactively.
GITLAB_TOKEN=glpat-...

# ---------------------------------------------------------------------------
# Workspace settings
# ---------------------------------------------------------------------------

# Private root for all Oompah, Git, and agent temporary files. This avoids
# shared /tmp quota exhaustion. It is created with owner-only permissions.
OOMPAH_TEMP_ROOT=~/.oompah/tmp

# Root directory where agent workspaces / git worktrees are created.
OOMPAH_WORKSPACE_ROOT=~/.oompah/workspaces

# Number of isolated pytest-xdist workers used by `make test` (default: 4).
# Accepted range: 1-16. Keep this bounded on memory- or storage-constrained
# hosts; use `make test-serial` when diagnosing ordering or concurrency issues.
OOMPAH_PYTEST_WORKERS=4

# ---------------------------------------------------------------------------
# Orchestrator tuning
# ---------------------------------------------------------------------------

# Maximum number of agents running in parallel (default: 10). Set to 0 to
# re-evaluate a conservative CPU/memory-based capacity on every scheduler tick.
OOMPAH_MAX_CONCURRENT_AGENTS=5

# ---------------------------------------------------------------------------
# Independent completion-auditor dispatch
# ---------------------------------------------------------------------------
# The audit lane runs on each scheduler tick and dispatches independent auditor
# agents for tasks in "In Validation" status. Auditors verify completed work
# before it advances to Done, Merged, or Archived.
# See docs/auditor-dispatch-operations.md for full configuration guidance.

# Maximum number of independent auditor candidates to attempt per audit before
# routing to Needs Human. Increase to match the number of independent providers
# in your auditor role. Must be a positive integer (default: 3).
OOMPAH_AUDIT_MAX_ATTEMPTS=3

# Time-to-live (seconds) for a running auditor attempt. A session older than
# this without completing is considered abandoned and reclaimed for rotation.
# A session with no live worker is reclaimed immediately.
# Default: 3600 (1 hour). Increase for slow CI environments.
OOMPAH_AUDIT_ATTEMPT_TTL=3600

# Relative dispatch priority for In Validation audits. The audit lane still
# runs before ordinary Open work when slots are available.
# Default: 100. Range: any positive integer.
OOMPAH_AUDIT_PRIORITY=100

# Maximum In Validation tasks scanned per scheduler tick. Set to 0 for no cap.
# Default: 32.
OOMPAH_AUDIT_LANE_SCAN_LIMIT=32

# Spending cap in USD — dispatch stops when this is reached (0 = unlimited)
OOMPAH_BUDGET_LIMIT=50.00

# Rolling budget window: hour | day | week. The cap above resets at the
# next calendar boundary (top of hour / local midnight / Sunday 00:00).
# Default: day.
# OOMPAH_BUDGET_WINDOW=day

# IANA timezone name used to align budget rolls to calendar boundaries.
# Empty (default) auto-detects the host's local timezone via TZ env or
# /etc/localtime. Set explicitly when you want a specific zone, e.g.
# "America/Los_Angeles" or "UTC". Invalid names fall back to UTC with a
# warning.
# OOMPAH_BUDGET_TIMEZONE=

# HTTP dashboard port (defaults to 8080 when unset; leave blank to disable)
OOMPAH_SERVER_PORT=8080

# HTTP server backend: uvicorn (default) or granian.
# Granian is a Rust/Tokio ASGI server with ~23% higher HTTP throughput than
# uvicorn in single-worker benchmarks. It is opt-in behind --server granian
# until the integration is fully hardened (see TASK-472).
# Can also be set on the CLI: oompah --server granian
# OOMPAH_SERVER_BACKEND=uvicorn

# Number of server worker processes (default: 1).
# IMPORTANT: granian requires workers=1. oompah holds shared in-process state
# (the orchestrator singleton and the _ws_clients WebSocket set in
# oompah/server.py) that is not safe to share across multiple OS-level worker
# processes. Setting OOMPAH_SERVER_WORKERS > 1 with granian will be rejected
# at startup with a clear error message.
# Can also be set on the CLI: oompah --workers 1
# OOMPAH_SERVER_WORKERS=1

# Polling interval in milliseconds (default: 120000)
OOMPAH_POLL_INTERVAL_MS=120000

# Full safety-net sync interval in milliseconds (default: 300000)
# OOMPAH_FULL_SYNC_INTERVAL_MS=300000

# Dispatch loop stale-detection threshold (default: 120000 = 2 minutes).
# If no tick fires within this many milliseconds, the dispatch loop is
# declared stale and recovery is armed. Set to 0 to fall back to the
# legacy formula: full_sync_interval_ms × dispatch_loop_stale_factor
# (which defaulted to a 15-minute threshold).
# OOMPAH_DISPATCH_STALE_THRESHOLD_MS=120000

# Expose the embedded MCP endpoint to non-loopback clients. Disabled by
# default; enabling this permits MCP task mutations from reachable clients.
# OOMPAH_MCP_ALLOW_NETWORK=false

# Grace period after staleness is detected before recovery fires (default: 30000 = 30 seconds).
# The extra wait prevents spurious recoveries during brief pauses. After
# (dispatch_stale_threshold_ms + dispatch_stale_grace_ms) of silence, the
# dispatch loop is restarted.
# OOMPAH_DISPATCH_STALE_GRACE_MS=30000

# Maximum dispatch candidates to examine per tick (0 = no cap, default: 64)
# OOMPAH_DISPATCH_SCAN_LIMIT=64

# Extra dispatchable candidates to keep beyond currently-free agent slots
# before ending the selection pass (default: 8)
# OOMPAH_DISPATCH_READY_BUFFER=8

# Maximum candidates to run duplicate detection on per tick
# (0 = no cap, default: 64)
# OOMPAH_DUPLICATE_DETECTION_CANDIDATE_LIMIT=64

# Maximum model-backed duplicate-screening agents that may qualify Open tasks
# from otherwise-available concurrency. Set to 0 to disable background
# preflight. Checked implementation work is dispatched before these workers.
# OOMPAH_DUPLICATE_PREFLIGHT_MAX_AGENTS=1

# Auto-archive and worktree cleanup budgets. These keep maintenance from
# monopolizing a scheduler tick after a large backlog has accumulated.
# OOMPAH_AUTO_ARCHIVE_BATCH_SIZE=25
# OOMPAH_AUTO_ARCHIVE_INTERVAL_SECONDS=300
# OOMPAH_WORKTREE_CLEANUP_BATCH_SIZE=25
# Comprehensive Oompah-owned storage scan cadence (default: 86400 = daily).
# Disk pressure bypasses this cadence and runs another bounded batch each tick
# until both free-space thresholds recover. Set a pressure threshold to 0 to
# disable that individual trigger.
# OOMPAH_STORAGE_CLEANUP_INTERVAL_SECONDS=86400
# OOMPAH_STORAGE_CLEANUP_PRESSURE_MIN_FREE_BYTES=5368709120
# OOMPAH_STORAGE_CLEANUP_PRESSURE_MIN_FREE_PERCENT=5
# OOMPAH_STORAGE_CLEANUP_MIN_AGE_SECONDS=86400
# OOMPAH_STORAGE_CLEANUP_BATCH_SIZE=50
# OOMPAH_STORAGE_CLEANUP_MAX_BYTES=53687091200
# OOMPAH_STORAGE_CLEANUP_LOG_RETENTION_SECONDS=604800
# OOMPAH_COORDINATION_RETENTION_SECONDS=2592000

# Repository hygiene health thresholds (OOMPAH-603)
# Operators use these thresholds to define when repository artifacts (worktrees
# and branches) should be reviewed. Age and cleanup errors determine health;
# count thresholds are trend notes and do not alert while artifacts are recent.
# See docs/repository-health-operations.md.
#
# Age (seconds) before a safely-prunable artifact is considered overdue for
# cleanup. Safely-prunable artifacts older than this are flagged in health
# reports and should be removed. Default: 604800 (7 days).
# OOMPAH_REPO_HYGIENE_SAFELY_PRUNABLE_AGE_SECONDS=604800
#
# Count threshold for an informational trend note when safely-prunable
# artifacts accumulate. Does not alert while artifacts are recent. Default: 10.
# OOMPAH_REPO_HYGIENE_SAFELY_PRUNABLE_COUNT_WARNING=10
#
# Count threshold for a critical trend note when safely-prunable artifacts
# accumulate. Does not alert while artifacts are recent. Default: 50.
# OOMPAH_REPO_HYGIENE_SAFELY_PRUNABLE_COUNT_CRITICAL=50
#
# Number of consecutive cleanup errors before a critical alert is raised.
# Tracks cleanup operation failures and triggers an alert after this many
# consecutive errors. Default: 3.
# OOMPAH_REPO_HYGIENE_CLEANUP_ERROR_THRESHOLD=3

# Maximum seconds a normal service restart waits for active agents to finish
# before persisting undrained tasks for lossless recovery (default: 3600).
# OOMPAH_RESTART_DRAIN_TIMEOUT_SECONDS=3600
# Maximum seconds for the full branch gate that runs once per exact
# review-ready head. Uses project test_command_full, then test_command.
# OOMPAH_QUALITY_GATE_TIMEOUT_SECONDS=3600
# Full SHA of the separately deployed lifecycle contract used by candidate
# quality gates. Leave empty to use the built-in OOMPAH-652 safety head; update
# this only after a lifecycle change has been reviewed and deployed first.
# OOMPAH_QUALITY_GATE_SAFETY_HEAD=
# OOMPAH_MAINTENANCE_STARTUP_DELAY_SECONDS=60
# OOMPAH_RELEASE_PICK_MAX_RUNTIME_SECONDS=15
# OOMPAH_MERGED_LABELS_MAX_RUNTIME_SECONDS=15
# OOMPAH_ISSUES_SNAPSHOT_STALE_MS=60000

# Stalled-task remediation watchdog interval in seconds (default: 1800 = 30 minutes).
# Controls how often the scheduler audits tasks stuck in Needs Human, Needs CI Fix,
# Needs Rebase, Needs Answer, and other stalled states and performs safe evidence-
# backed remediations (e.g. reopening a task that was accidentally stalled).
# OOMPAH_STALLED_TASK_WATCHDOG_INTERVAL_SECONDS=1800

# Maximum duration of an explicit direct-owner work claim (default: 48 hours).
# Expired claims are removed by the orphan watchdog, allowing normal recovery.
# OOMPAH_OWNER_CLAIM_TTL_HOURS=48

# ---------------------------------------------------------------------------
# Multi-process service split (TASK-469.5.1)
# ---------------------------------------------------------------------------
# SQLite database path shared between the scheduler and API processes.
# When set, the scheduler publishes state/issues snapshots to this database
# after every tick; the API process reads from it instead of blocking on the
# scheduler's Python GIL (YAML parsing).  Leave unset (default) for the
# standard single-process combined mode.
#
# Example (shared tmpfs for low-latency reads):
# OOMPAH_IPC_DB_PATH=/tmp/oompah_ipc.db
#
# See plans/service-split.md for the full architecture and roadmap.
# OOMPAH_IPC_DB_PATH=

# ---------------------------------------------------------------------------
# Agent behaviour
# ---------------------------------------------------------------------------

# Timeout for agent `run_command` shell tools (default: 720). Keep this above
# `OOMPAH_TASK_CLI_TIMEOUT_SECONDS` so a busy but successful local task update
# is not killed by the agent tool wrapper first.
# OOMPAH_AGENT_COMMAND_TIMEOUT_SECONDS=720

# Maximum time to wait for a cancelled agent worker during task termination or
# service shutdown. Set to 0 only to permit an indefinite graceful wait.
# OOMPAH_WORKER_TERMINATION_TIMEOUT_MS=10000

# Timeout for `oompah task ...` CLI calls to the local server (default: 600).
# Increase this if agents post comments or task updates while the server is
# busy enough that successful API calls approach the client timeout.
# OOMPAH_TASK_CLI_TIMEOUT_SECONDS=600

# Consecutive turns with no productive action before marking agent as stalled (default: 10)
OOMPAH_STALL_TURNS=10

# Escalate to a deeper profile after N failed attempts (default: 1)
OOMPAH_ESCALATE_AFTER_ATTEMPTS=1

# Start every issue on the catch-all "default" profile instead of the best match.
# Only escalate to the matched profile after a failed attempt. Saves budget when
# most issues resolve on the cheap default model. Default: false (opt-in).
# Also configurable via agent.default_first_dispatch: true in WORKFLOW.md.
OOMPAH_DEFAULT_FIRST_DISPATCH=false

# DEPRECATED: OOMPAH_VERIFY_COMPLETION and OOMPAH_VERIFY_COMPLETION_LLM are
# retained for one compatibility release but do NOT control the mandatory
# terminal-audit gate. Configure the auditor role in .oompah/roles.json instead.
# See docs/auditor-dispatch-operations.md for the migration guide.
# A startup warning is emitted when either variable is set.
#
# Completion verifier (oompah-zlz_2-y0ns). When true, after a worker exits
# successfully AND has moved the task to a terminal state, oompah runs a
# two-stage verifier against the task's "# Acceptance criteria" section.
# DEPRECATED — use the independent auditor role (OOMPAH_AUDIT_MAX_ATTEMPTS).
OOMPAH_VERIFY_COMPLETION=false

# Companion flag: when false, the LLM stage 2 of the verifier is skipped
# entirely. DEPRECATED — LLM verification is now part of the auditor role.
OOMPAH_VERIFY_COMPLETION_LLM=true

# Source of truth for agent.profiles[]. By default the JSON store at
# .oompah/agent_profiles.json wins after a one-shot migration from
# WORKFLOW.md, so profiles are edited via the dashboard UI. Set this to
# "workflow" to keep WORKFLOW.md authoritative — the UI then becomes
# read-only. See docs/agent-profiles.md for the full precedence rules.
# OOMPAH_AGENT_PROFILES_SOURCE=workflow

# Source-of-truth strictness for agent.profiles configuration
# (oompah-zlz_2-hye). Agent profiles live in
# .oompah/agent_profiles.json (managed via /api/v1/agent-profiles); the
# legacy WORKFLOW.md agent.profiles block is no longer authoritative.
#  - "warn"   (default) — log a warning and surface a dashboard alert
#                         when WORKFLOW.md still has a stale block that
#                         differs from the persisted store. Continue.
#  - "strict"           — refuse to start if WORKFLOW.md still has any
#                         agent.profiles block at all. Use after the
#                         migration to lock the legacy section out.
# Also configurable via agent.strict_profile_source in WORKFLOW.md.
# OOMPAH_STRICT_PROFILE_SOURCE=warn

# Auto-decompose issue into sub-tasks after N failed attempts (default: 2)
OOMPAH_DECOMPOSE_AFTER_ATTEMPTS=2

# Max backoff delay between retries in milliseconds (default: 300000)
OOMPAH_MAX_RETRY_BACKOFF_MS=300000

# TTL (seconds) for the GitHubProvider per-PR DETAIL fetch cache
# (oompah/scm.py). The cache is keyed on (head_sha, updated_at), but
# GitHub does NOT always bump updated_at when async-recomputing
# mergeable_state after a base-branch commit lands — without a TTL,
# stale cached "clean" entries can persist indefinitely. Default 60s
# is a small per-PR refresh cost in exchange for catching DIRTY
# transitions that GitHub silently recomputes.
# OOMPAH_PR_DETAIL_CACHE_TTL_SECONDS=60

# Grace period (seconds) for GitHub CI checks to register on a newly observed
# PR head SHA. Successful empty status/check-run responses remain pending
# during this bounded window. If the exact SHA stays check-free for the full
# window, it is classified as no-CI and remains eligible for YOLO merging.
# A synchronize/head-SHA change always starts a new window. Default: 60s.
# OOMPAH_CI_REGISTRATION_GRACE_SECONDS=60

# ---------------------------------------------------------------------------
# Self-hosted GitHub Actions runner
# ---------------------------------------------------------------------------
# The runner script (scripts/runner.sh) and Makefile targets (runner-setup,
# runner-start, runner-stop, runner-status) manage a containerized self-hosted
# GitHub Actions runner using Podman (or Docker as a fallback).
#
# Required: GITHUB_TOKEN above must have "Self-hosted runners: Read and write"
# permission in addition to the webhook/contents permissions already described.
#
# Target repository for runner registration (default: lesserevil/oompah)
# OOMPAH_RUNNER_REPO=lesserevil/oompah
#
# Runner name shown in the GitHub Actions UI (default: oompah-runner)
# OOMPAH_RUNNER_NAME=oompah-runner
#
# Comma-separated runner labels (default: self-hosted,linux,x64,oompah).
# CI workflows target the 'oompah' label. Do not remove self-hosted, linux,
# or x64 — GitHub requires self-hosted for routing and linux/x64 for
# environment compatibility assertions.
# NOTE: GitHub Actions does NOT support an OR expression between GitHub-hosted
# and self-hosted labels. Setting runs-on: [self-hosted, oompah] makes this
# host the sole required capacity for CI — GitHub-hosted runners are bypassed.
# OOMPAH_RUNNER_LABELS=self-hosted,linux,x64,oompah
#
# Pinned container image for the runner (update to pick up runner upgrades).
# Always pin to a specific version tag — never use 'latest'.
# OOMPAH_RUNNER_IMAGE=ghcr.io/actions/actions-runner:2.323.0
#
# Host directory that stores runner configuration between restarts.
# Must be writable by the current user; created automatically by runner-setup.
# OOMPAH_RUNNER_WORKDIR=.runner-data
#
# Container name for the runner (used by start/stop/status commands).
# OOMPAH_RUNNER_CONTAINER=oompah-actions-runner

# ---------------------------------------------------------------------------
# Agent startup prompt history
# ---------------------------------------------------------------------------
# Bound task-comment history embedded in each fresh agent's startup prompt.
# Oompah always retains the latest actionable human context, latest focus
# handoff, final Needs Human instruction, and recent comments. The complete
# canonical history remains available through `oompah task view`.
# Minimum: 5 comments. Default: 20.
# OOMPAH_PROMPT_MAX_COMMENTS=20
#
# UTF-8 byte budget for retained comment text. Oversized retained comments
# preserve their beginning and end and point to the canonical task history.
# Minimum: 1024. Default: 32768 (32 KiB).
# OOMPAH_PROMPT_MAX_COMMENT_BYTES=32768

# ---------------------------------------------------------------------------
# Repository map (OOMPAH-293 epic)
# ---------------------------------------------------------------------------
# The repository-map feature generates a compact structural index of each
# managed project and injects it into agent prompts so agents arrive with
# codebase context rather than discovering it by grepping.  Maps are stored
# on the project's Git-backed state branch (oompah/state/<project-id>) —
# no daemon, database, or externally hosted service is required.
#
# Prerequisites before enabling:
#   1. The managed project must have state_branch_enabled=True.
#      New projects get a state branch automatically on bootstrap.
#      Existing projects: run `oompah project-bootstrap apply` and
#      ensure the state branch was created (see docs/project-bootstrap.md).
#   2. Set OOMPAH_REPO_MAP_ENABLED=true below.
#
# See docs/repository-map.md for full activation, freshness, diagnostics,
# privacy/trust, and rebuild procedures.

# Master enable switch. Default: false (safe off until explicitly activated).
# OOMPAH_REPO_MAP_ENABLED=false

# Token budget passed to the map renderer. The rendered output is capped at
# this many whitespace-separated tokens so large repos don't overflow the
# agent's context window. Must be a positive integer; default: 2000.
# OOMPAH_REPO_MAP_TOKEN_BUDGET=2000

# Comma-separated list of languages to index. Must be a subset of the
# supported set: javascript, markdown, python, rust, typescript, yaml.
# Any unsupported language causes the whole value to be rejected and the
# full default set to be used instead. Default: all supported languages.
# OOMPAH_REPO_MAP_LANGUAGES=javascript,markdown,python,rust,typescript,yaml

# Maximum size (bytes) of a single source file that the indexer will read.
# Files larger than this limit are silently skipped. Must be >= 1.
# Default: 1000000 (1 MB).
# OOMPAH_REPO_MAP_MAX_FILE_SIZE=1000000

# Wall-clock seconds a single map-generation run may take before it is
# cancelled and a timeout result is returned. Must be >= 1. Default: 120.
# OOMPAH_REPO_MAP_GENERATION_TIMEOUT=120

# Maximum number of per-repository map artifacts retained on the state branch.
# Older artifacts are pruned after a new one is written. Must be >= 1.
# Default: 5.
# OOMPAH_REPO_MAP_RETAINED_ARTIFACTS=5

# ---------------------------------------------------------------------------
# HTTP Basic Authentication (optional, OOMPAH-521 epic)
# ---------------------------------------------------------------------------
# Optional Apache-style htpasswd file for HTTP Basic authentication. See
# docs/authentication.md for deployment, HTTPS, rotation, and recovery.
#
# When set, Oompah validates credentials at startup (fatal if invalid) and
# enforces authentication on HTTP routes. Complete atomic replacements are
# reloaded on the next authenticated request; malformed, partial, symlink, or
# unreadable replacements retain the last known-good verifier (see OOMPAH-594).
#
# Path resolution:
#   - OOMPAH_HTPASSWD_FILE=.htpasswd     — relative: resolved against .env dir
#   - OOMPAH_HTPASSWD_FILE=/etc/htpass   — absolute: used as-is (for secrets)
#   - Unset or empty                     — discovery mode (tries .htpasswd beside .env)
#
# Discovery behavior:
#   - .htpasswd beside .env found   → auth enabled (not an error if missing)
#   - Explicit path configured      → fatal if missing or unreadable
#   - File present but malformed    → fatal (fail-closed)
#   - File present but empty        → fatal (no valid credentials)
#   - Plaintext passwords           → fatal (must use bcrypt or APR1)
#
# Supported password formats:
#   - bcrypt ($2y$, $2b$, $2a$)     — recommended, modern, adaptive cost
#   - APR1 ($apr1$)                 — common in Apache, supported for compatibility
#
# Example entry shape only (never paste a real credential here):
#   operator:<bcrypt-hash-generated-by-htpasswd>
# Existing APR1 entries are accepted for compatibility.
#
# Do NOT commit .htpasswd or other credential files to git. These patterns
# are automatically ignored by .gitignore. See secret scanning docs.
#
# OOMPAH_HTPASSWD_FILE=

# Client credentials for first-party task/admin CLIs and Makefile lifecycle
# commands. These are plaintext client inputs, not server htpasswd data. The
# first-party clients reread them from the current .env for each operator run;
# spawned workers never inherit or reload them. See
# docs/authentication.md#cli-credential-precedence for the exact
# CLI/env/default-netrc precedence and hostname-selection rules.
# Set OOMPAH_SERVER_USERNAME plus exactly one password source. Prefer a
# regular mode-0600 file containing only the plaintext password for unattended
# use. OOMPAH_SERVER_PASSWORD is a limited environment-only alternative; do
# not put its value in this file or in a command argument.
#
# Default netrc source (when these variables and CLI flags are absent):
# ~/.netrc, mode 600, with an entry such as:
# machine oompah.example.com
# login <username>
# password <password>
# The server strips these client-only values before launching agent processes.
# OOMPAH_SERVER_USERNAME=
# OOMPAH_SERVER_PASSWORD=
# OOMPAH_SERVER_PASSWORD_FILE=

# ---------------------------------------------------------------------------
# Model providers
# ---------------------------------------------------------------------------
# Provider configuration (base URLs, API keys, models, roles) is managed
# in .oompah/providers.json — NOT in this file. Each provider has its own
# base_url and api_key, supporting multiple providers simultaneously.
#
# Use the dashboard or API to add/edit providers, or edit the file directly.
# See .oompah/providers.json for the current configuration.
